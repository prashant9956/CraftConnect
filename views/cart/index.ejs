<% layout("layouts/boilerplate") %>

<div class="cart-page">

    <div class="cart-header">
        <h1>Your Cart</h1>
        <p>Review your selected handmade products.</p>
    </div>

    <% if (!cart.items || cart.items.length === 0) { %>

        <div class="empty-cart">
            <div class="empty-cart-icon">🛒</div>

            <h2>Your cart is empty</h2>

            <p>
                Discover beautiful handmade products from local artisans.
            </p>

            <a href="/marketplace" class="primary-btn">
                Explore Marketplace
            </a>
        </div>

    <% } else { %>

        <div class="cart-layout">

            <!-- CART ITEMS -->
            <div class="cart-items">

                <% cart.items.forEach(item => { %>

                    <div class="cart-item">

                        <!-- PRODUCT IMAGE -->
                        <div class="cart-item-image">

                            <% if (item.product.image) { %>

                                <img
                                    src="<%= item.product.image.startsWith('http')
                                        ? item.product.image
                                        : '/uploads/' + item.product.image %>"
                                    alt="<%= item.product.productName %>"
                                >

                            <% } else { %>

                                <div class="no-cart-image">
                                    <span>✦</span>
                                    <small>No Image</small>
                                </div>

                            <% } %>

                        </div>

                        <!-- PRODUCT INFO -->
                        <div class="cart-item-info">

                            <h3>
                                <%= item.product.productName %>
                            </h3>

                            <p>
                                <%= item.product.category %>
                            </p>

                            <strong>
                                ₹<%= Number(item.product.price || 0)
                                    .toLocaleString("en-IN") %>
                            </strong>

                            <span>
                                Quantity: <%= item.quantity %>
                            </span>

                        </div>

                        <!-- REMOVE -->
                        <div class="cart-item-actions">

                            <form
                                action="/cart/remove/<%= item.product._id %>"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="delete-btn"
                                >
                                    Remove
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- ORDER SUMMARY -->
            <div class="cart-summary">

                <h2>Order Summary</h2>

                <div class="summary-row">

                    <span>Items</span>

                    <strong>
                        <%= cart.items.length %>
                    </strong>

                </div>

                <div class="summary-row">

                    <span>Total</span>

                    <strong>
                        ₹<%= cart.items.reduce(
                            (total, item) =>
                            total +
                            (Number(item.product.price || 0) * item.quantity),
                            0
                        ).toLocaleString("en-IN") %>
                    </strong>

                </div>

                <button
                    type="button"
                    class="checkout-btn"
                >
                    Proceed to Checkout
                </button>

            </div>

        </div>

    <% } %>

</div>