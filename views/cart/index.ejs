<% layout("layouts/boilerplate") %>

<section class="hero">
    <div class="hero-content">

        <div class="hero-badge">
            ✦ AI-Powered Artisan Marketplace
        </div>

        <h1>
            Empowering Artisans,
            <span>Connecting Communities.</span>
        </h1>

        <p>
            CraftConnect helps local artisans showcase their
            handmade products, use AI-powered product listing,
            and reach customers through a digital marketplace.
        </p>

        <div class="hero-buttons">
            <a href="/marketplace" class="primary-btn">
                Explore Marketplace →
            </a>

            <a href="/signup" class="secondary-btn">
                Become an Artisan
            </a>
        </div>

        <div class="hero-features">

            <div class="hero-feature">
                <div class="feature-icon">🤖</div>
                <div>
                    <strong>AI-Powered</strong>
                    <span>Smart product listings</span>
                </div>
            </div>

            <div class="hero-feature">
                <div class="feature-icon">🛍️</div>
                <div>
                    <strong>Unique Crafts</strong>
                    <span>Discover handmade products</span>
                </div>
            </div>

            <div class="hero-feature">
                <div class="feature-icon">🤝</div>
                <div>
                    <strong>Support Artisans</strong>
                    <span>Connect directly with creators</span>
                </div>
            </div>

        </div>

    </div>
</section>