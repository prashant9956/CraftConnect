<% layout("layouts/boilerplate") %>

<div class="marketplace-page">

    <!-- ==================== HERO ==================== -->
    <section class="marketplace-hero">
        <div class="marketplace-hero-overlay"></div>

        <div class="marketplace-hero-content">
            <span class="marketplace-badge">
                ✦ CraftConnect Marketplace
            </span>

            <h1>
                Discover
                <span>Beautiful Handmade Crafts</span>
            </h1>

            <p>
                Explore unique products created by local artisans
                and discover the stories behind every craft.
            </p>

            <div class="marketplace-hero-stats">
                <div>
                    <strong><%= products.length %>+</strong>
                    <span>Crafts Available</span>
                </div>

                <div class="hero-stat-divider"></div>

                <div>
                    <strong>AI</strong>
                    <span>Powered Listings</span>
                </div>

                <div class="hero-stat-divider"></div>

                <div>
                    <strong>Local</strong>
                    <span>Artisan Community</span>
                </div>
            </div>
        </div>
    </section>


    <!-- ==================== SEARCH + FILTER ==================== -->
    <section class="marketplace-controls-section">

        <div class="marketplace-controls">

            <div class="controls-heading">
                <span class="controls-label">FIND YOUR CRAFT</span>
                <h2>Explore the Marketplace</h2>
                <p>
                    Search for unique handmade products or browse by category.
                </p>
            </div>

            <form
                action="/marketplace"
                method="GET"
                class="marketplace-search-form"
            >

                <div class="marketplace-search">
                    <span class="search-icon">⌕</span>

                    <input
                        type="text"
                        name="search"
                        placeholder="Search handmade products..."
                        value="<%= search %>"
                    >
                </div>


                <div class="marketplace-category">
                    <select name="category">

                        <option
                            value="All"
                            <%= category === "All" ? "selected" : "" %>
                        >
                            All Categories
                        </option>

                        <option
                            value="Home Decor"
                            <%= category === "Home Decor" ? "selected" : "" %>
                        >
                            Home Decor
                        </option>

                        <option
                            value="Handicrafts"
                            <%= category === "Handicrafts" ? "selected" : "" %>
                        >
                            Handicrafts
                        </option>

                        <option
                            value="Jewellery"
                            <%= category === "Jewellery" ? "selected" : "" %>
                        >
                            Jewellery
                        </option>

                        <option
                            value="Clothing"
                            <%= category === "Clothing" ? "selected" : "" %>
                        >
                            Clothing
                        </option>

                        <option
                            value="Pottery"
                            <%= category === "Pottery" ? "selected" : "" %>
                        >
                            Pottery
                        </option>

                        <option
                            value="Paintings"
                            <%= category === "Paintings" ? "selected" : "" %>
                        >
                            Paintings
                        </option>

                        <option
                            value="Other"
                            <%= category === "Other" ? "selected" : "" %>
                        >
                            Other
                        </option>

                    </select>
                </div>


                <button
                    type="submit"
                    class="marketplace-search-btn"
                >
                    Search
                    <span>→</span>
                </button>

            </form>

        </div>

    </section>


    <!-- ==================== PRODUCTS ==================== -->
    <main class="marketplace-container">

        <div class="marketplace-heading">

            <div>
                <span class="section-label">
                    ✦ EXPLORE CRAFTS
                </span>

                <h2>
                    Handmade Products
                </h2>
            </div>

            <div class="products-count">
                <strong><%= products.length %></strong>
                product<%= products.length === 1 ? "" : "s" %> found
            </div>

        </div>


        <% if (products.length === 0) { %>

            <!-- EMPTY STATE -->

            <div class="empty-marketplace">

                <div class="empty-icon">
                    ✦
                </div>

                <h3>
                    No products found
                </h3>

                <p>
                    We couldn't find anything matching your search.
                    Try another keyword or category.
                </p>

                <a
                    href="/marketplace"
                    class="clear-filter-btn"
                >
                    View All Products
                    <span>→</span>
                </a>

            </div>

        <% } else { %>


            <!-- PRODUCT GRID -->

            <div class="product-grid">

                <% products.forEach((product, index) => { %>

                    <article class="marketplace-product-card">

                        <!-- PRODUCT IMAGE -->

                        <div class="product-image-wrapper">

                            <% if (product.image) { %>

                                <img
                                    src="/uploads/<%= product.image %>"
                                    alt="<%= product.productName %>"
                                    class="marketplace-product-image"
                                >

                            <% } else { %>

                                <div class="product-image-placeholder">
                                    <span>✦</span>
                                    <small>Handmade Craft</small>
                                </div>

                            <% } %>


                            <!-- CATEGORY -->

                            <span class="product-category-badge">
                                <%= product.category %>
                            </span>


                            <!-- QUICK LABEL -->

                            <span class="product-artisan-label">
                                ✦ Handmade
                            </span>

                        </div>


                        <!-- PRODUCT CONTENT -->

                        <div class="product-card-content">

                            <div class="product-card-top">

                                <h3>
                                    <%= product.productName %>
                                </h3>

                                <% if (product.material) { %>

                                    <p class="product-material">
                                        <span>Material</span>
                                        <%= product.material %>
                                    </p>

                                <% } %>

                            </div>


                            <% if (product.description) { %>

                                <p class="product-description">

                                    <%= product.description.length > 100
                                        ? product.description.substring(0, 100) + "..."
                                        : product.description
                                    %>

                                </p>

                            <% } %>


                            <!-- PRICE + BUTTON -->

                            <div class="product-card-bottom">

                                <div class="product-price-box">

                                    <span class="price-label">
                                        Price
                                    </span>

                                    <div class="product-price">
                                        ₹<%= Number(product.price || 0).toLocaleString("en-IN") %>
                                    </div>

                                </div>


                                <a
                                    href="/marketplace/product/<%= product._id %>"
                                    class="view-product-btn"
                                >
                                    View Product
                                    <span>→</span>
                                </a>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </main>

</div>