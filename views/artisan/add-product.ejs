<% layout("layouts/boilerplate") %>

<div class="product-page">

    <!-- HEADER -->
    <div class="product-header">
        <span class="product-eyebrow">CRAFTCONNECT • ARTISAN</span>

        <h1>Add New Product</h1>

        <p>
            Showcase your handmade creation and connect it with customers.
        </p>
    </div>


    <form
        action="/artisan/products"
        method="POST"
        enctype="multipart/form-data"
    >

        <div class="product-form">

            <!-- ================= IMAGE SECTION ================= -->
            <div class="form-section image-section">

                <div class="section-heading">
                    <div class="section-number">01</div>

                    <div>
                        <h2>Product Image</h2>
                        <p>
                            Add a clear, attractive image of your handmade product.
                        </p>
                    </div>
                </div>


                <label for="productImage" class="image-upload">

                    <div class="upload-icon">
                        ✦
                    </div>

                    <div class="upload-content">

                        <strong>Upload Product Image</strong>

                        <span>
                            Click to browse or choose an image
                        </span>

                        <small>
                            JPG, PNG, WEBP • Recommended high quality image
                        </small>

                    </div>

                    <input
                        type="file"
                        id="productImage"
                        name="image"
                        accept="image/*"
                        required
                    >

                </label>

                <div id="imagePreview" class="image-preview"></div>

            </div>


            <!-- ================= PRODUCT INFORMATION ================= -->
            <div class="form-section">

                <div class="section-heading">

                    <div class="section-number">02</div>

                    <div>
                        <h2>Product Information</h2>
                        <p>
                            Tell customers about your unique handmade creation.
                        </p>
                    </div>

                </div>


                <!-- PRODUCT NAME -->
                <div class="form-group">

                    <label for="productName">
                        Product Name
                    </label>

                    <input
                        type="text"
                        id="productName"
                        name="productName"
                        placeholder="e.g. Handmade Wooden Elephant"
                        required
                    >

                </div>


                <!-- CATEGORY + MATERIAL -->
                <div class="form-row">

                    <div class="form-group">

                        <label for="category">
                            Category
                        </label>

                        <select
                            id="category"
                            name="category"
                            required
                        >
                            <option value="">
                                Select Category
                            </option>

                            <option value="Home Decor">
                                Home Decor
                            </option>

                            <option value="Handicrafts">
                                Handicrafts
                            </option>

                            <option value="Jewellery">
                                Jewellery
                            </option>

                            <option value="Clothing">
                                Clothing
                            </option>

                            <option value="Pottery">
                                Pottery
                            </option>

                            <option value="Paintings">
                                Paintings
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="material">
                            Material
                        </label>

                        <input
                            type="text"
                            id="material"
                            name="material"
                            placeholder="e.g. Wood, Clay, Cotton"
                        >

                    </div>

                </div>


                <!-- PRICE -->
                <div class="form-group">

                    <label for="price">
                        Price
                    </label>

                    <div class="price-input">

                        <span>₹</span>

                        <input
                            type="number"
                            id="price"
                            name="price"
                            placeholder="Enter product price"
                            min="1"
                            required
                        >

                    </div>

                </div>


                <!-- DESCRIPTION -->
                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="6"
                        placeholder="Describe your product, its story, craftsmanship and uniqueness..."
                    ></textarea>

                    <small class="field-hint">
                        Tell customers what makes this product special.
                    </small>

                </div>


                <!-- TAGS -->
                <div class="form-group">

                    <label for="tags">
                        Tags
                    </label>

                    <input
                        type="text"
                        id="tags"
                        name="tags"
                        placeholder="handmade, traditional, wooden"
                    >

                    <small class="field-hint">
                        Separate multiple tags with commas.
                    </small>

                </div>

            </div>

        </div>


        <!-- ================= ACTIONS ================= -->

        <div class="form-actions">

            <a
                href="/artisan/dashboard"
                class="cancel-btn"
            >
                Cancel
            </a>

            <button
                type="submit"
                class="primary-btn"
            >
                Save Product
                <span>→</span>
            </button>

        </div>

    </form>

</div>


<script>

    const imageInput = document.getElementById("productImage");
    const imagePreview = document.getElementById("imagePreview");

    imageInput.addEventListener("change", function () {

        const file = this.files[0];

        if (!file) {
            imagePreview.innerHTML = "";
            return;
        }

        const imageURL = URL.createObjectURL(file);

        imagePreview.innerHTML = `
            <div class="preview-card">
                <img src="${imageURL}" alt="Product Preview">

                <div class="preview-info">
                    <strong>${file.name}</strong>
                    <span>Image selected successfully</span>
                </div>
            </div>
        `;

    });

</script>