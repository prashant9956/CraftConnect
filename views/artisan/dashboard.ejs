<% layout("layouts/boilerplate") %>

<div class="dashboard">

    <!-- Dashboard Header -->
    <div class="dashboard-header">

        <div>
            <h1>Artisan Dashboard</h1>
            <p>Manage your products, orders and earnings.</p>
        </div>

        <div class="dashboard-actions">

            <a
                href="/artisan/products/new"
                class="primary-btn"
            >
                + Add Product
            </a>

            <a
                href="/artisan/products/ai-upload"
                class="ai-btn"
            >
                ✨ AI Product Upload
            </a>

        </div>

    </div>


    <!-- Statistics -->
    <div class="stats-grid">

        <div class="stat-card">
            <h3>Total Products</h3>
            <h2><%= products.length %></h2>
            <p>Products listed</p>
        </div>

        <div class="stat-card">
            <h3>Total Orders</h3>
            <h2>0</h2>
            <p>Orders received</p>
        </div>

        <div class="stat-card">
            <h3>Total Earnings</h3>
            <h2>₹0</h2>
            <p>This month</p>
        </div>

        <div class="stat-card">
            <h3>Product Views</h3>
            <h2>0</h2>
            <p>Last 30 days</p>
        </div>

    </div>


    <!-- Recent Products -->
    <div class="dashboard-section">

        <div class="section-header">

            <h2>Recent Products</h2>

            <a href="/artisan/products">
                View All
            </a>

        </div>


        <% if (products.length === 0) { %>

            <!-- Empty State -->

            <div class="empty-products">

                <h3>Your products will appear here</h3>

                <p>
                    Add your first handmade product to start selling.
                </p>

                <a
                    href="/artisan/products/new"
                    class="primary-btn"
                >
                    Add Your First Product
                </a>

            </div>


        <% } else { %>


            <!-- Product Grid -->

            <div class="product-grid">

                <% products.forEach(product => { %>

                    <div class="product-card">


                        <!-- Product Image -->

                        <div class="product-image-wrapper">

                            <% if (product.image) { %>

                                <img
                                    src="/uploads/<%= product.image %>"
                                    alt="<%= product.productName %>"
                                    class="product-card-image"
                                >

                            <% } else { %>

                                <div class="no-image">
                                    <span>No Image</span>
                                </div>

                            <% } %>

                        </div>


                        <!-- Product Information -->

                        <div class="product-card-content">

                            <h3>
                                <%= product.productName %>
                            </h3>

                            <p class="product-category">
                                <%= product.category %>
                            </p>

                            <strong class="product-price">
                                ₹<%= product.price %>
                            </strong>


                            <!-- Actions -->

                            <div class="product-card-actions">

                                <a
                                    href="/artisan/products/<%= product._id %>/edit"
                                    class="edit-btn"
                                >
                                    Edit
                                </a>


                                <form
                                    action="/artisan/products/<%= product._id %>?_method=DELETE"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this product?');"
                                >

                                    <button
                                        type="submit"
                                        class="delete-btn"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</div>


<!-- ========================================
     DASHBOARD PRODUCT CARD CSS
======================================== -->

<style>

    .product-grid {
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(250px, 1fr)
        );
        gap: 24px;
        margin-top: 20px;
    }


    /* Product Card */

    .product-card {
        background: #ffffff;
        border: 1px solid #ead9ca;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(80, 45, 25, 0.08);
        transition: transform 0.2s ease,
                    box-shadow 0.2s ease;

        display: flex;
        flex-direction: column;
    }


    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 32px rgba(80, 45, 25, 0.14);
    }


    /* FIXED IMAGE CONTAINER */

    .product-image-wrapper {
        width: 100%;
        height: 230px;

        background: #f5eee8;

        overflow: hidden;

        display: flex;
        align-items: center;
        justify-content: center;
    }


    /* ALL PRODUCT IMAGES SAME SIZE */

    .product-card-image {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
        object-position: center;
    }


    /* No Image */

    .no-image {
        width: 100%;
        height: 100%;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #f2e7dc;

        color: #8b6b55;

        font-size: 14px;
        font-weight: 700;
    }


    /* Product Content */

    .product-card-content {
        padding: 18px;

        display: flex;
        flex-direction: column;

        flex: 1;
    }


    .product-card-content h3 {
        margin: 0 0 7px;

        color: #713b20;

        font-size: 18px;
        line-height: 1.35;

        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;

        overflow: hidden;
    }


    .product-category {
        margin: 0 0 12px;

        color: #8a7769;

        font-size: 13px;
    }


    .product-price {
        color: #a45128;

        font-size: 20px;

        margin-bottom: 18px;
    }


    /* Edit + Delete */

    .product-card-actions {
        display: flex;

        gap: 10px;

        margin-top: auto;
    }


    .product-card-actions form {
        margin: 0;

        flex: 1;
    }


    .edit-btn,
    .delete-btn {
        width: 100%;

        display: flex;

        align-items: center;
        justify-content: center;

        min-height: 40px;

        padding: 9px 12px;

        border-radius: 8px;

        font-size: 13px;

        font-weight: 700;

        text-decoration: none;

        cursor: pointer;

        transition: 0.2s ease;
    }


    /* Edit */

    .edit-btn {
        background: #aab58a;

        color: #344124;

        border: 1px solid #929f70;
    }


    .edit-btn:hover {
        background: #526238;

        color: #ffffff;

        transform: translateY(-1px);
    }


    /* Delete */

    .delete-btn {
        background: #f1d4ca;

        color: #8b3422;

        border: 1px solid #dfb2a5;
    }


    .delete-btn:hover {
        background: #a33d26;

        color: #ffffff;

        transform: translateY(-1px);
    }


    /* Responsive */

    @media (max-width: 700px) {

        .product-grid {
            grid-template-columns: 1fr;
        }

        .product-image-wrapper {
            height: 250px;
        }

    }


    @media (min-width: 701px) and (max-width: 1000px) {

        .product-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

    }

</style>