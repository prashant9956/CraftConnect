<% layout("layouts/boilerplate") %>

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-header">

            <span class="auth-eyebrow">
                CRAFTCONNECT
            </span>

            <h1>Welcome Back</h1>

            <p>
                Login to continue your CraftConnect journey.
            </p>

        </div>


        <form action="/login" method="POST">

            <div class="auth-form-group">

                <label for="email">
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >

            </div>


            <div class="auth-form-group">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    required
                >

            </div>


            <button
                type="submit"
                class="auth-submit-btn"
            >
                Login →
            </button>

        </form>


        <div class="auth-footer">

            Don't have an account?

            <a href="/signup">
                Create Account
            </a>

        </div>

    </div>

</div>