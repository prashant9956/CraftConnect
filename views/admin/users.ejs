<style>

    .admin-container {
        max-width: 1250px;
        margin: 40px auto;
        padding: 0 25px 60px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0;
        color: #3e2723;
        font-size: 32px;
    }

    .page-header p {
        margin-top: 7px;
        color: #777;
    }

    .back-btn {
        text-decoration: none;
        background: #8b5e3c;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 700;
    }

    .users-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.07);
        border: 1px solid #eee;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 750px;
    }

    .users-table th {
        text-align: left;
        padding: 14px;
        background: #f7f2ee;
        color: #5d4037;
        font-size: 14px;
    }

    .users-table td {
        padding: 16px 14px;
        border-bottom: 1px solid #eee;
        color: #555;
    }

    .user-name {
        font-weight: 700;
        color: #3e2723;
    }

    .user-email {
        font-size: 13px;
        color: #888;
        margin-top: 3px;
    }

    .role-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .role-admin {
        background: #eee0ff;
        color: #6a1b9a;
    }

    .role-artisan {
        background: #fff0d6;
        color: #a65b00;
    }

    .role-buyer {
        background: #e3f4e8;
        color: #287a3d;
    }

    .delete-btn {
        border: none;
        background: #c62828;
        color: white;
        padding: 8px 13px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 700;
    }

    .delete-btn:hover {
        background: #a91f1f;
    }

    .protected-text {
        color: #999;
        font-size: 13px;
    }

    .empty-state {
        text-align: center;
        padding: 50px;
        color: #888;
    }

</style>


<div class="admin-container">

    <div class="page-header">

        <div>
            <h1>👥 Manage Users</h1>

            <p>
                View and manage CraftConnect users.
            </p>
        </div>

        <a
            href="/admin"
            class="back-btn"
        >
            ← Dashboard
        </a>

    </div>


    <div class="users-card">

        <% if (users.length === 0) { %>

            <div class="empty-state">
                <h2>No users found</h2>
                <p>There are no registered users yet.</p>
            </div>

        <% } else { %>

            <table class="users-table">

                <thead>

                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    <% users.forEach(user => { %>

                        <tr>

                            <td>

                                <div class="user-name">
                                    <%= user.name %>
                                </div>

                                <div class="user-email">
                                    <%= user.email %>
                                </div>

                            </td>


                            <td>

                                <%
                                    let roleClass = "role-buyer";

                                    if (user.role === "admin") {
                                        roleClass = "role-admin";
                                    }

                                    if (user.role === "artisan") {
                                        roleClass = "role-artisan";
                                    }
                                %>

                                <span class="role-badge <%= roleClass %>">
                                    <%= user.role.toUpperCase() %>
                                </span>

                            </td>


                            <td>

                                <%= new Date(user.createdAt).toLocaleDateString("en-IN") %>

                            </td>


                            <td>

                                <% if (
                                    currentUser &&
                                    currentUser.id.toString() === user._id.toString()
                                ) { %>

                                    <span class="protected-text">
                                        Current Admin
                                    </span>

                                <% } else { %>

                                    <form
                                        action="/admin/users/<%= user._id %>?_method=DELETE"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this user?');"
                                    >

                                        <button
                                            type="submit"
                                            class="delete-btn"
                                        >
                                            Delete
                                        </button>

                                    </form>

                                <% } %>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } %>

    </div>

</div>