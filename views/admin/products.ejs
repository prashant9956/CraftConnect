<div class="admin-page">

    <!-- HEADER -->
    <div class="admin-header">

        <div>
            <h1>Manage Products</h1>
            <p>Monitor and manage products listed by artisans.</p>
        </div>

        <a href="/admin" class="back-btn">
            ← Back to Dashboard
        </a>

    </div>


    <!-- PRODUCTS -->
    <% if (!products || products.length === 0) { %>

        <div class="empty-state">
            <div class="empty-icon">🏺</div>

            <h2>No Products Found</h2>

            <p>
                No products have been added by artisans yet.
            </p>
        </div>

    <% } else { %>

        <div class="products-table-wrapper">

            <table class="products-table">

                <thead>

                    <tr>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Material</th>
                        <th>Price</th>
                        <th>Artisan</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    <% products.forEach(product => { %>

                        <tr>

                            <!-- IMAGE -->
                            <td>

                                <% if (product.image) { %>

                                    <%
                                        let imagePath = product.image;

                                        if (
                                            !imagePath.startsWith("/") &&
                                            !imagePath.startsWith("http")
                                        ) {
                                            imagePath = "/uploads/" + imagePath.replace(/^uploads[\/\\]/, "");
                                        }
                                    %>

                                    <img
                                        src="<%= imagePath %>"
                                        alt="<%= product.productName %>"
                                        class="product-img"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                    >

                                    <div
                                        class="no-image"
                                        style="display:none;"
                                    >
                                        Image unavailable
                                    </div>

                                <% } else { %>

                                    <div class="no-image">
                                        No Image
                                    </div>

                                <% } %>

                            </td>


                            <!-- PRODUCT NAME -->
                            <td>

                                <strong>
                                    <%= product.productName %>
                                </strong>

                            </td>


                            <!-- CATEGORY -->
                            <td>

                                <span class="category-badge">
                                    <%= product.category || "Other" %>
                                </span>

                            </td>


                            <!-- MATERIAL -->
                            <td>

                                <%= product.material || "—" %>

                            </td>


                            <!-- PRICE -->
                            <td>

                                <strong class="price">
                                    ₹<%= product.price %>
                                </strong>

                            </td>


                            <!-- ARTISAN -->
                            <td>

                                <% if (product.artisan) { %>

                                    <strong>
                                        <%= product.artisan.name %>
                                    </strong>

                                    <br>

                                    <small>
                                        <%= product.artisan.email %>
                                    </small>

                                <% } else { %>

                                    <span class="unknown">
                                        Unknown Artisan
                                    </span>

                                <% } %>

                            </td>


                            <!-- DATE -->
                            <td>

                                <%= new Date(product.createdAt).toLocaleDateString("en-IN") %>

                            </td>


                            <!-- DELETE -->
                            <td>

                                <form
                                    action="/admin/products/<%= product._id %>?_method=DELETE"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this product?');"
                                >

                                    <button
                                        type="submit"
                                        class="delete-btn"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

</div>


<style>

/* =========================
   ADMIN PRODUCTS PAGE
========================= */

.admin-page {
    max-width: 1350px;
    margin: 40px auto;
    padding: 0 25px;
}


/* =========================
   HEADER
========================= */

.admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
}

.admin-header h1 {
    margin: 0;
    color: #3d2b1f;
    font-size: 30px;
}

.admin-header p {
    margin: 8px 0 0;
    color: #777;
    font-size: 15px;
}


/* =========================
   BACK BUTTON
========================= */

.back-btn {
    text-decoration: none;
    background: #8b5e3c;
    color: white;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: 700;
    white-space: nowrap;
    transition: 0.2s;
}

.back-btn:hover {
    background: #6d452c;
}


/* =========================
   TABLE CONTAINER
========================= */

.products-table-wrapper {
    width: 100%;
    background: white;
    border-radius: 14px;
    overflow-x: auto;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}


/* =========================
   TABLE
========================= */

.products-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1050px;
}

.products-table th,
.products-table td {
    padding: 15px;
    text-align: left;
    border-bottom: 1px solid #eee;
    vertical-align: middle;
}

.products-table th {
    background: #f5eee8;
    color: #3d2b1f;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
}

.products-table tbody tr:hover {
    background: #fffaf6;
}


/* =========================
   PRODUCT IMAGE
========================= */

.product-img {
    width: 75px;
    height: 65px;
    object-fit: cover;
    object-position: center;
    border-radius: 9px;
    display: block;
    background: #f5eee8;
    border: 1px solid #eee;
}

.no-image {
    width: 75px;
    height: 65px;
    background: #f1f1f1;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 11px;
    color: #888;
}


/* =========================
   PRODUCT NAME
========================= */

.products-table td strong {
    color: #3d2b1f;
}


/* =========================
   CATEGORY
========================= */

.category-badge {
    display: inline-block;
    background: #f5eee8;
    color: #8b5e3c;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}


/* =========================
   PRICE
========================= */

.price {
    color: #2e7d32 !important;
    white-space: nowrap;
}


/* =========================
   ARTISAN
========================= */

.products-table small {
    color: #777;
    font-size: 12px;
}

.unknown {
    color: #999;
    font-size: 13px;
}


/* =========================
   DELETE BUTTON
========================= */

.delete-btn {
    border: none;
    background: #c0392b;
    color: white;
    padding: 8px 14px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: 600;
    transition: 0.2s;
}

.delete-btn:hover {
    background: #962d22;
}


/* =========================
   EMPTY STATE
========================= */

.empty-state {
    text-align: center;
    padding: 80px 20px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
}

.empty-icon {
    font-size: 50px;
    margin-bottom: 10px;
}

.empty-state h2 {
    margin: 10px 0;
    color: #3d2b1f;
}

.empty-state p {
    color: #777;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

    .admin-page {
        margin: 25px auto;
        padding: 0 15px;
    }

    .admin-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .admin-header h1 {
        font-size: 25px;
    }

    .back-btn {
        width: fit-content;
    }

}

</style>