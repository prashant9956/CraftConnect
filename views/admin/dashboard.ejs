<style>

    .admin-container {
        max-width: 1250px;
        margin: 40px auto;
        padding: 0 25px 60px;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        gap: 20px;
    }

    .admin-header h1 {
        margin: 0;
        font-size: 32px;
        color: #3e2723;
    }

    .admin-header p {
        margin: 7px 0 0;
        color: #777;
    }

    .admin-badge {
        background: #8b5e3c;
        color: white;
        padding: 10px 18px;
        border-radius: 25px;
        font-weight: 700;
    }


    /* =========================
       STAT CARDS
    ========================= */

    .admin-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 1px solid #eee;
    }

    .stat-icon {
        font-size: 30px;
        margin-bottom: 12px;
    }

    .stat-title {
        color: #777;
        font-size: 14px;
        margin-bottom: 7px;
    }

    .stat-number {
        font-size: 30px;
        font-weight: 800;
        color: #3e2723;
    }


    /* =========================
       SECTION
    ========================= */

    .admin-section {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.07);
        border: 1px solid #eee;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .section-header h2 {
        margin: 0;
        color: #3e2723;
        font-size: 22px;
    }


    /* =========================
       PRODUCT TABLE
    ========================= */

    .product-table {
        width: 100%;
        border-collapse: collapse;
    }

    .product-table th {
        text-align: left;
        padding: 14px;
        background: #f7f2ee;
        color: #5d4037;
        font-size: 14px;
    }

    .product-table td {
        padding: 15px 14px;
        border-bottom: 1px solid #eee;
        color: #555;
        vertical-align: middle;
    }

    .product-table tr:last-child td {
        border-bottom: none;
    }

    .product-image {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 10px;
        background: #f1e8e1;
    }

    .no-image {
        width: 55px;
        height: 55px;
        border-radius: 10px;
        background: #f1e8e1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .product-name {
        font-weight: 700;
        color: #3e2723;
    }

    .category-badge {
        display: inline-block;
        padding: 5px 10px;
        background: #f1e8e1;
        color: #6d4c41;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .price {
        font-weight: 700;
        color: #2e7d32;
    }

    .artisan-name {
        font-weight: 600;
        color: #5d4037;
    }

    .artisan-email {
        font-size: 12px;
        color: #999;
        margin-top: 3px;
    }


    /* =========================
       ADMIN ACTIONS
    ========================= */
.admin-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin: 0 0 30px;
    flex-wrap: wrap;
}

.admin-action-btn {
    text-decoration: none;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: 700;
    background: #8b5e3c;
    color: white;
    transition: 0.2s;
}

.admin-action-btn:hover {
    background: #6d452c;
}

    /* =========================
       EMPTY STATE
    ========================= */

    .empty-state {
        text-align: center;
        padding: 45px 20px;
        color: #888;
    }

    .empty-state-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }


    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 900px) {

        .admin-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .admin-section {
            overflow-x: auto;
        }

        .product-table {
            min-width: 750px;
        }
    }


    @media (max-width: 550px) {

        .admin-container {
            margin-top: 25px;
            padding: 0 15px 40px;
        }

        .admin-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-stats {
            grid-template-columns: 1fr;
        }
    }

</style>

        <!-- ACTION BUTTONS -->
<div class="admin-actions">

    <a
        href="/admin"
        class="admin-action-btn"
    >
        📊 Dashboard
    </a>

    <a
        href="/admin/users"
        class="admin-action-btn"
    >
        👥 Manage Users
    </a>

    <a
        href="/admin/products"
        class="admin-action-btn"
    >
        🏺 Manage Products
    </a>

    <a
        href="/marketplace"
        class="admin-action-btn"
    >
        🛍️ Marketplace
    </a>

</div>
    </div>


<div class="admin-container">

    <!-- =========================
         HEADER
    ========================== -->

    <div class="admin-header">

        <div>

            <h1>
                Admin Dashboard
            </h1>

            <p>
                Welcome back, <strong><%= currentUser.name %></strong>.
                Manage CraftConnect from here.
            </p>

        </div>

        <div class="admin-badge">
            🛡️ Administrator
        </div>

    </div>


    <!-- =========================
         STATISTICS
    ========================== -->

    <div class="admin-stats">

        <!-- USERS -->

        <div class="stat-card">

            <div class="stat-icon">
                👥
            </div>

            <div class="stat-title">
                Total Users
            </div>

            <div class="stat-number">
                <%= totalUsers %>
            </div>

        </div>


        <!-- ARTISANS -->

        <div class="stat-card">

            <div class="stat-icon">
                🎨
            </div>

            <div class="stat-title">
                Total Artisans
            </div>

            <div class="stat-number">
                <%= totalArtisans %>
            </div>

        </div>


        <!-- BUYERS -->

        <div class="stat-card">

            <div class="stat-icon">
                🛍️
            </div>

            <div class="stat-title">
                Total Buyers
            </div>

            <div class="stat-number">
                <%= totalBuyers %>
            </div>

        </div>


        <!-- PRODUCTS -->

        <div class="stat-card">

            <div class="stat-icon">
                🏺
            </div>

            <div class="stat-title">
                Total Products
            </div>

            <div class="stat-number">
                <%= totalProducts %>
            </div>

        </div>

    </div>


    <!-- =========================
         RECENT PRODUCTS
    ========================== -->

    <div class="admin-section">

        <div class="section-header">

            <h2>
                🆕 Recent Products
            </h2>

        </div>


        <% if (recentProducts.length === 0) { %>

            <div class="empty-state">

                <div class="empty-state-icon">
                    🏺
                </div>

                <p>
                    No products have been added yet.
                </p>

            </div>

        <% } else { %>

            <table class="product-table">

                <thead>

                    <tr>

                        <th>
                            Product
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Price
                        </th>

                        <th>
                            Artisan
                        </th>

                        <th>
                            Added
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% recentProducts.forEach(product => { %>

                        <tr>

                            <!-- PRODUCT -->

                            <td>

                                <div style="
                                    display:flex;
                                    align-items:center;
                                    gap:12px;
                                ">

                                    <% if (product.image) { %>

                                        <img
                                            src="<%= product.image %>"
                                            class="product-image"
                                            alt="<%= product.productName %>"
                                        >

                                    <% } else { %>

                                        <div class="no-image">
                                            🏺
                                        </div>

                                    <% } %>


                                    <div>

                                        <div class="product-name">
                                            <%= product.productName %>
                                        </div>

                                        <div style="
                                            font-size:12px;
                                            color:#999;
                                            margin-top:3px;
                                        ">

                                            <%= product.material || "Handcrafted Product" %>

                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- CATEGORY -->

                            <td>

                                <span class="category-badge">
                                    <%= product.category %>
                                </span>

                            </td>


                            <!-- PRICE -->

                            <td>

                                <span class="price">
                                    ₹<%= Number(product.price).toLocaleString("en-IN") %>
                                </span>

                            </td>


                            <!-- ARTISAN -->

                            <td>

                                <% if (product.artisan) { %>

                                    <div class="artisan-name">
                                        <%= product.artisan.name %>
                                    </div>

                                    <div class="artisan-email">
                                        <%= product.artisan.email %>
                                    </div>

                                <% } else { %>

                                    <span>
                                        Unknown
                                    </span>

                                <% } %>

                            </td>


                            <!-- DATE -->

                            <td>

                                <%= new Date(product.createdAt).toLocaleDateString("en-IN") %>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } %>


</div>